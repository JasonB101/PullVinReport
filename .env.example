##############################################################################
# Vehicle History by VIN — environment configuration
#
# Copy to .env.local and fill in. Nothing here is required to browse the site,
# the sample report, or /status. The paid path requires the VinAudit and Stripe
# blocks below; without them checkout is switched off rather than falling back
# to sample data.
#
# Vercel production cutover (set these on the Production environment):
#   NEXT_PUBLIC_SITE_URL=https://vehiclehistorybyvin.com
#   SITE_URL=https://vehiclehistorybyvin.com
#   EMAIL_FROM="Vehicle History by VIN <orders@vehiclehistorybyvin.com>"
#   SUPPORT_EMAIL=support@vehiclehistorybyvin.com
#   NEXT_PUBLIC_GA_MEASUREMENT_ID=G-E2Z25ZEBVF
# Leave preview/dev on localhost or the Vercel preview host. Paid-path keys
# (VinAudit, Stripe, Resend, fal, Ads) stay as they are.
##############################################################################

# --- Site ------------------------------------------------------------------
# Public base URL. Used for Stripe redirect URLs, emailed report links,
# canonical tags and the sitemap. No trailing slash.
# Local default below. Production: https://vehiclehistorybyvin.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Sitewide GA4 (gtag). Set to a G- id (e.g. G-E2Z25ZEBVF) to load; leave empty to omit the GA4 config.
# Google Ads AW-18440939667 is always configured on the same sitewide gtag (vehiclehistorybyvin.com only).
# Purchase conversion AW-18440939667/VQOrCJabp_IcEJPRqdlE still fires only after Stripe success.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Pricing ---------------------------------------------------------------
# Price of one report, in the smallest currency unit. 1499 = $14.99.
REPORT_PRICE_CENTS=1499
# ISO 4217 currency code, lowercase, as Stripe expects it.
REPORT_CURRENCY=usd

# --- VinAudit Vehicle History API (REQUIRED for paid reports) --------------
# All three must be set. If any is missing, /api/checkout returns 503, the
# preview page disables the buy button, and /api/status returns 503. Paid
# orders are NEVER fulfilled with sample data.
VINAUDIT_API_KEY=
VINAUDIT_USER=
VINAUDIT_PASS=
# Optional overrides.
VINAUDIT_API_BASE=https://api.vinaudit.com
VINAUDIT_TIMEOUT_MS=25000

# --- Stripe (REQUIRED for checkout) ----------------------------------------
# Secret key: sk_test_... in development, sk_live_... in production.
STRIPE_SECRET_KEY=
# Signing secret for POST /api/stripe/webhook.
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Refunds ---------------------------------------------------------------
# Refund a charge automatically when its report pull fails, instead of leaving
# it for an operator to refund from /admin. Off by default: the documented flow
# is retry-then-refund, and a refunded charge can't be retried without asking
# the customer to pay again. Refunds are always available by hand in /admin.
AUTO_REFUND_FAILED_ORDERS=false

# --- Email receipts via Resend (optional) ----------------------------------
# Covers the report receipt and the refund notice. Without this the report is
# still delivered on screen and refunds still go through at Stripe; only the
# email is skipped. Verify the sending domain in Resend before going live.
RESEND_API_KEY=
# Sender and reply-to. Both must stay on the vehiclehistorybyvin.com
# domain — this product never sends as another brand. Defaults match
# these values. On Vercel, update EMAIL_FROM and SUPPORT_EMAIL to this
# domain when you cut over (and verify it in Resend).
#
# EMAIL_FROM must keep the double quotes. The display-name form is
# `Name <address>`, and unquoted angle brackets are redirection syntax to a
# shell and get stripped or truncated by several .env parsers. Quote it in
# .env.local and in your host's environment UI too.
EMAIL_FROM="Vehicle History by VIN <orders@vehiclehistorybyvin.com>"
SUPPORT_EMAIL=support@vehiclehistorybyvin.com

# --- Written brief on the report (optional) ---------------------------------
# With a key set, each paid report gains a short written brief at the top: what
# the records for that order add up to, plus known trouble spots for the year,
# make and model, labelled as being about the model and not that VIN. Without a
# key the card is simply not shown and nothing else changes.
#
# The brief is written once and cached on the order row, so reopening a report
# costs nothing; rewriting one is an explicit action in /admin. Only the report's
# own summary is sent — never the VIN, the buyer, or the order.
ANTHROPIC_API_KEY=
# Optional. Admin API key (sk-ant-admin…) for /admin USD spend MTD via
# GET /v1/organizations/cost_report. The Messages key above cannot read
# Cost Report; leave this unset and Anthropic is omitted from /admin.
# Remaining prepaid credits are Console-only (not in the Admin API);
# /admin links to Console Billing rather than inventing a leftover.
ANTHROPIC_ADMIN_API_KEY=
# Optional. Any current Messages API model id. The default is Claude Sonnet:
# the brief is written once per order and then cached, so the better writer is
# paid for once and read every time the report is opened.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_TIMEOUT_MS=45000

# --- Illustrated vehicle hero on the report (optional) ----------------------
# With a key set, each paid report draws a product-cutout of the year/make/
# model (trim and exterior colour when the records have them) and shows it
# to the right of the vehicle details. Generated once per
# year/make/model/trim/colour and cached. Unset
# means no hero and no other change. Never a photograph of the VIN.
#
# Get a key at https://fal.ai (FAL_KEY). Recraft V3 digital illustration is
# the default so the picture cannot read as a photo (V4 on fal has no style
# lock and leans photoreal). Recraft does not return alpha; a rembg pass
# cuts the background to a transparent PNG. Do not set a realistic_* style.
FAL_KEY=
# Optional. Admin-scope key for the /admin fal credit balance
# (GET /v1/account/billing). An API-scope FAL_KEY will 401/403 and fal is
# then shown as unavailable (needs Admin-scope key) — never as 0.
FAL_ADMIN_KEY=
FAL_IMAGE_MODEL=fal-ai/recraft/v3/text-to-image
FAL_IMAGE_STYLE=digital_illustration
FAL_REMBG_MODEL=fal-ai/imageutils/rembg
FAL_API_BASE=https://fal.run
FAL_TIMEOUT_MS=45000

# --- Google Ads spend on /admin (optional) ---------------------------------
# Official Google Ads API only (v25 Search). Omit any of the four required
# auth vars and the tile is hidden — never shown as $0.00. A failed token
# refresh or search is shown as unavailable. Account timezone America/Denver
# is applied by the API date macros TODAY / THIS_MONTH.
#
# Developer tokens are issued on a manager (MCC) account. When calling the
# client customer through that MCC, GOOGLE_ADS_LOGIN_CUSTOMER_ID is required
# and is sent as the login-customer-id header (digits only, no dashes).
# Leave it unset only for a rare direct-account token; the header is then
# omitted.
#
# Secrets come from the Adria/Jason Vercel path — do not invent values.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# Client customer id, digits only. Defaults to this product's Ads account.
# GOOGLE_ADS_CUSTOMER_ID=7544762158
# MCC / manager customer id. Required when the developer token lives on an MCC.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Storage ---------------------------------------------------------------
# Set DATABASE_URL to use Postgres (recommended for production). The orders
# table is created automatically on first use. Leave it unset and orders are
# written to a local JSON file instead — fine for development and the demo,
# but NOT durable on serverless hosts.
DATABASE_URL=
# Force TLS when the connection string doesn't already imply it.
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Directory for the file store fallback.
DATA_DIR=.data

# --- Admin console ---------------------------------------------------------
# Password for /admin. Leave unset and the admin console is locked out
# entirely. Use a long random value.
ADMIN_PASSWORD=
